{
	"name": "pi-wabapp",
	"version": "0.1.0",
	"description": "Browser dashboard for pi coding-agent sessions: live activity, subagent trees, prompts, screenshots and Playwright recordings.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"dashboard",
		"subagents",
		"playwright"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/luxuride-pi-extensions/pi-wabapp.git"
	},
	"homepage": "https://github.com/luxuride-pi-extensions/pi-wabapp",
	"files": [
		"src",
		"web",
		"dist",
		"scripts",
		"README.md",
		"LICENSE",
		"tsconfig.json",
		"tsconfig.build.json"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"prepare": "node scripts/build.mjs",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && node --check dist/web/app.js",
		"test": "node tests/smoke.mjs",
		"prepublishOnly": "npm run build && npm run typecheck"
	},
	"dependencies": {
		"preact": "^10.27.2",
		"ws": "^8.18.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@tailwindcss/cli": "^4.3.5",
		"@types/node": "^22.19.0",
		"@types/ws": "^8.18.1",
		"daisyui": "^5.8.1",
		"esbuild": "^0.25.12",
		"tailwindcss": "^4.3.5",
		"typebox": "^1.3.27",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
