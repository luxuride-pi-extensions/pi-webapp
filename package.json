{
	"name": "pi-webapp",
	"version": "0.3.0",
	"description": "Browser dashboard for pi coding-agent sessions: live activity, subagent trees, prompts, screenshots and Playwright recordings.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"dashboard",
		"subagents",
		"playwright"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/luxuride-pi-extensions/pi-webapp.git"
	},
	"homepage": "https://github.com/luxuride-pi-extensions/pi-webapp",
	"files": [
		"bin",
		"src",
		"web",
		"dist",
		"examples",
		"bin",
		"scripts",
		"README.md",
		"LICENSE",
		"tsconfig.json",
		"tsconfig.build.json"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"prepare": "node scripts/prepare.mjs",
		"postinstall": "node scripts/postinstall.mjs",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && node --check dist/web/app.js",
		"test": "node tests/smoke.mjs",
		"prepublishOnly": "npm run build && npm run typecheck",
		"test:daemon": "node tests/daemon.mjs",
		"test:all": "node tests/smoke.mjs && node tests/daemon.mjs",
		"test:autostart": "node tests/autostart.mjs"
	},
	"dependencies": {
		"@juicesharp/rpiv-todo": "^2.15.0",
		"billion-context": "^0.1.215",
		"highlight.js": "^11.12.0",
		"pi-lens": "^4.5.0",
		"pi-web-access": "^0.47.0",
		"preact": "^10.27.2",
		"version": "^0.1.2",
		"view": "^1.1.1",
		"ws": "^8.18.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@tailwindcss/cli": "^4.3.5",
		"@types/node": "^22.19.0",
		"@types/ws": "^8.18.1",
		"daisyui": "^5.8.1",
		"esbuild": "^0.25.12",
		"tailwindcss": "^4.3.5",
		"typebox": "^1.3.27",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"bin": {
		"pi-webapp": "./bin/pi-webapp.mjs"
	}
}
